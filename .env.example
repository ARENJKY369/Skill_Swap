# SkillSwap environment configuration. Copy to .env and fill in real values.
# .env is gitignored; never commit secrets.

# HTTP port for the Spring Boot service (API + built frontend in production)
PORT=8787

# Any of these set to production/prod enables secure cookies, CSP/HSTS and omits dev codes.
# Leave unset (or development) for local work; npm start passes -DAPP_ENV=production.
# NODE_ENV=development
# APP_ENV=
# SPRING_PROFILES_ACTIVE=

# Secret used to hash one-time email codes and 2FA recovery codes.
# REQUIRED in production; generate a long random string.
APP_SECRET=change-me-to-a-long-random-string

# Comma-separated allowlist for cross-origin API calls (leave empty when served same-origin)
CORS_ORIGIN=

# Optional SQLite database path; defaults to ./data/skillswap.db
SKILLSWAP_DB=./data/skillswap.db

# OAuth client IDs (public values; the client secret stays server-side only)
GOOGLE_CLIENT_ID=
FACEBOOK_CLIENT_ID=
X_CLIENT_ID=
LINKEDIN_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_SECRET=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_SECRET=

# Public client-exposed values (Vite only exposes VITE_* to the bundle)
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_CLIENT_ID=
VITE_X_CLIENT_ID=
VITE_LINKEDIN_CLIENT_ID=

# Base URL for OAuth redirects
PUBLIC_BASE_URL=http://localhost:8787

# SMTP (optional; without it, verification codes are printed to the server console in dev)
SMTP_URL=
