# SkillSwap environment configuration. Copy to .env and fill in real values.
# .env is gitignored; never commit secrets.

# HTTP port for the Express server (serves API + built frontend in production)
PORT=8787

# Secret used to hash session tokens at rest is handled via crypto.randomBytes;
# this value salts CSRF tokens and one-time codes. REQUIRED in production.
APP_SECRET=change-me-to-a-long-random-string

# Comma-separated allowlist for cross-origin API calls (leave empty when served same-origin)
CORS_ORIGIN=

# OAuth client IDs (public values; the client secret stays server-side only)
GOOGLE_CLIENT_ID=
FACEBOOK_CLIENT_ID=
X_CLIENT_ID=
LINKEDIN_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_SECRET=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_SECRET=

# Public client-exposed values (Vite only exposes VITE_* to the bundle)
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_CLIENT_ID=
VITE_X_CLIENT_ID=
VITE_LINKEDIN_CLIENT_ID=

# Base URL for OAuth redirects
PUBLIC_BASE_URL=http://localhost:8787

# SMTP (optional; without it, verification codes are printed to the server console in dev)
SMTP_URL=
